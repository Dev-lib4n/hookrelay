{
    "name": "hookrelay/laravel-webhook-broker",
    "type": "project",
    "description": "HookRelay - Resilient Webhook Gateway and Retry Queue Broker built with PHP 8.3 and Laravel 11.",
    "keywords": [
        "laravel",
        "webhooks",
        "broker",
        "horizon",
        "redis",
        "postgresql"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.29"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
